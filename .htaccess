# Blindaje extra: aunque PHP debería procesar este archivo siempre,
# esto evita que se sirva como texto plano (con la contraseña de la
# base de datos adentro) si algo llegara a fallar.
<Files "config.php">
    Require all denied
</Files>

# Lo mismo para setup.php una vez que ya creaste el usuario admin:
# borralo del servidor, no hace falta dejarlo online.

# Las dependencias de Composer y sus archivos de control no son parte
# del sitio: nadie tiene que poder pedirlas por HTTP.
RedirectMatch 403 ^/vendor(/|$)
<FilesMatch "^composer\.(json|lock)$">
    Require all denied
</FilesMatch>
